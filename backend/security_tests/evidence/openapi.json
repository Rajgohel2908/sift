    "/query": {
      "post": {
        "summary": "Execute baseline RAG search and generation",
        "description": "Search indexed content and generate a grounded, cited answer.\n- If best score < min_score: returns status 'insufficient_evidence' (LLM is not called).\n- If answers lack valid citations: returns status 'unverified'.\n- If citations are valid: returns status 'answered'.",
        "operationId": "query_endpoint_query_post",
        "requestBody": {
          "content": {
